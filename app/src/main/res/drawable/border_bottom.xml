<?xml version="1.0" encoding="utf-8"?>
<!--
  This drawable creates a bottom border for the table rows.
  It uses a layer-list to push a rectangle up by 1dp, leaving only the bottom stroke visible.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="0dp"
        android:left="-2dp"
        android:right="-2dp"
        android:top="-2dp">
        <shape android:shape="rectangle">
            <!-- The border color (light gray) -->
            <stroke
                android:width="1dp"
                android:color="#E0E0E0" />
            <!-- The background color of the row -->
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>