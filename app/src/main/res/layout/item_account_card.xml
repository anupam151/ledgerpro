<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    tools:ignore="HardcodedText">

    <!-- Card Content Container -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Bank Name -->
        <TextView
            android:id="@+id/tv_acc_bank_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bank Name"
            android:textColor="#9E9E9E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Card Nickname -->
        <TextView
            android:id="@+id/tv_acc_card_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_acc_bank_name"
            android:layout_marginTop="4dp"
            android:text="Card Name"
            android:textColor="#192033"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Masked Last 4 Digits -->
        <TextView
            android:id="@+id/tv_acc_card_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_acc_card_name"
            android:layout_marginTop="4dp"
            android:text="•••• 1234"
            android:textColor="#666666"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <!-- Total Credit Limit Header -->
        <TextView
            android:id="@+id/tv_acc_limit_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="CREDIT LIMIT"
            android:textColor="#9E9E9E"
            android:textSize="11sp" />

        <!-- Total Credit Limit Value -->
        <TextView
            android:id="@+id/tv_acc_card_limit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_acc_limit_header"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="2dp"
            android:text="₹0.00"
            android:textColor="#4CAF50"
            android:textSize="16sp"
            android:textStyle="bold" />

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>