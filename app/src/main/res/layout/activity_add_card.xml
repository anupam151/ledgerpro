<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainAddCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9F9F9"
    tools:ignore="HardcodedText, ContentDescription, TooManyViews">

    <!-- ==================== TOP ACTION BAR ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#192033"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/back"
            app:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tvActivityTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Add Credit Card"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnClearAllFields"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/delete_wh"
            app:tint="#FF1F1F"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- ==================== SCROLLABLE FORM CONTENT ==================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Card Nickname Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Card Nickname (e.g. Amazon Pay)"
                android:textColorHint="#9E9E9E"
                app:hintTextColor="#192033"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCardName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="#192033"
                    android:singleLine="true"
                    android:imeOptions="actionNext"
                    android:nextFocusForward="@+id/spinBankName" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Bank Name Filterable Dropdown -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBankName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Bank Name"
                android:textColorHint="#9E9E9E"
                app:hintTextColor="#192033"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spinBankName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#192033"
                    android:singleLine="true"
                    android:imeOptions="actionNext"
                    android:nextFocusForward="@+id/spinCardType" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Card Network Dropdown -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCardType"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Card Network"
                android:textColorHint="#9E9E9E"
                app:hintTextColor="#192033"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spinCardType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#192033"
                    android:singleLine="true"
                    android:imeOptions="actionNext"
                    android:nextFocusForward="@+id/etLast4Digits" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Horizontal Row: Last 4 Digits & Billing Day -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:baselineAligned="false">

                <!-- Last 4 Digits Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:hint="Last 4 Digits"
                    android:textColorHint="#9E9E9E"
                    app:hintTextColor="#192033"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLast4Digits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="4"
                        android:textColor="#192033"
                        android:singleLine="true"
                        android:imeOptions="actionNext"
                        android:nextFocusForward="@+id/etBillingDay" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Billing Day Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:hint="Billing Day (1-31)"
                    android:textColorHint="#9E9E9E"
                    app:hintTextColor="#192033"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBillingDay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="2"
                        android:textColor="#192033"
                        android:singleLine="true"
                        android:imeOptions="actionNext"
                        android:nextFocusForward="@+id/etTotalLimit" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Total Credit Limit Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:hint="Total Credit Limit"
                android:textColorHint="#9E9E9E"
                app:hintTextColor="#192033"
                app:prefixText="₹"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTotalLimit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="#192033"
                    android:singleLine="true"
                    android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ==================== CASHBACK SECTION ==================== -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchCashback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Track Cashback Rewards"
                android:textColor="#192033"
                android:textSize="16sp"
                android:textStyle="bold"
                app:thumbTint="#FFFFFF" /> <!-- Fixes switch visibility -->

            <!-- Dynamic Rates Input (Visible when switch is ON) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCashbackRates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:hint="Cashback Rates % (e.g. 1, 1.5, 5)"
                android:textColorHint="#9E9E9E"
                app:hintTextColor="#192033"
                app:helperText="Separate multiple tiers with commas"
                app:helperTextTextColor="#667085"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCashbackRates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="#192033"
                    android:singleLine="true"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ==================== THEME COLOR PICKER ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Card Theme Color"
                    android:textColor="#192033"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Color Preview Swatch -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardColorPreview"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#192033"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- Reset Theme Color Button -->
                <ImageView
                    android:id="@+id/btnResetColor"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/reset"
                    app:tint="#192033"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ==================== STICKY BOTTOM ACTION FOOTER ==================== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:padding="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveCard"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save Card"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            android:backgroundTint="#192033" />
    </FrameLayout>
</LinearLayout>