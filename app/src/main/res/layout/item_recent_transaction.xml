<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    android:background="?attr/selectableItemBackground"
    tools:ignore="HardcodedText,ContentDescription">

    <!-- Modern Circular Icon Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_icon_container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardBackgroundColor="#F4F5F7"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_transaction_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_gallery"
            app:tint="#5C6BC0" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Merchant Title (Bold, Truncated) -->
    <TextView
        android:id="@+id/tv_transaction_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Merchant Name"
        android:textColor="#192033"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tv_transaction_date"
        app:layout_constraintEnd_toStartOf="@id/tv_transaction_amount"
        app:layout_constraintStart_toEndOf="@id/card_icon_container"
        app:layout_constraintTop_toTopOf="@id/card_icon_container"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Date (Softened) -->
    <TextView
        android:id="@+id/tv_transaction_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Transaction Date"
        android:textColor="#8F9BB3"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/card_icon_container"
        app:layout_constraintEnd_toEndOf="@id/tv_transaction_title"
        app:layout_constraintStart_toStartOf="@id/tv_transaction_title"
        app:layout_constraintTop_toBottomOf="@id/tv_transaction_title" />

    <!-- Transaction Amount -->
    <TextView
        android:id="@+id/tv_transaction_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹0.00"
        android:textColor="#192033"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>